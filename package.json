{
  "name": "usd1ball",
  "version": "0.1.0",
  "private": true,
  "description": "USD1BALL - A USD1-based flywheel meme coin on Solana",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "anchor:build": "cd programs/usd1ball && anchor build",
    "anchor:test": "cd programs/usd1ball && anchor test",
    "anchor:deploy": "cd programs/usd1ball && anchor deploy",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
